# Copy to .env.staging on the server (chmod 600). Never commit real values.
DATABASE_URL="postgresql://quin:CHANGE_ME@db:5432/quin_staging?schema=public"
POSTGRES_PASSWORD="CHANGE_ME"

APP_ENV=staging
APP_VERSION=dev
NEXT_PUBLIC_SITE_URL=https://quin.yosuaf.com
ROBOTS_NOINDEX=true

# SESSION_SECRET is reserved for future signed cookies; sessions are DB-backed today.
SESSION_SECRET="generate-with-openssl-rand-hex-32"

UPLOAD_DIR=/data/uploads
IP_HASH_SALT="generate-with-openssl-rand-hex-16"

# Set only when a real proxied origin exists; leave empty to trust CF-Connecting-IP / XFF.
TRUSTED_IP_HEADER=

# Optional integrations
TURNSTILE_SECRET=
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_FROM=